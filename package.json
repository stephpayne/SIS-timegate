{
  "name": "sis-timegate",
  "version": "1.4.0",
  "private": true,
  "description": "SCORM Timegate packaging and observability runtime",
  "scripts": {
    "test": "node --test tests/runtime/observability.test.js",
    "test:packaging": "python3 -m unittest discover -s installer/tests -v",
